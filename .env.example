# PayBrief — copy to .env. Everything is optional: with nothing set, AI + PayPal run in labelled MOCK mode.

PORT=5174
# Public base URL (used for mock pay links)
PUBLIC_URL=http://localhost:5174

# --- PayPal (real sandbox) ---
# Free: https://developer.paypal.com/dashboard/applications/sandbox -> Create App -> copy Client ID + Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5174/?paid=1
PAYPAL_CANCEL_URL=http://localhost:5174/?cancelled=1
INVOICER_NAME=AonHive Studio
# 1 = let PayPal email the invoice to the recipient (sandbox). Default 0 = no emails, link only.
PAYPAL_SEND_INVOICE_EMAIL=0
# 1 = force mock even if creds are set
PAYPAL_FORCE_MOCK=0

# --- AI (any OpenAI-compatible chat API) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_FORCE_MOCK=0

# --- Reminder agent ---
REMINDER_DELAY_SECONDS=60
REMINDER_POLL_SECONDS=15
REMINDER_MAX_NUDGES=3
DATA_FILE=data/payments.json
